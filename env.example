# MoneyClip v4 — Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ============================================================
# REQUIRED
# ============================================================

# PostgreSQL connection string (Neon)
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Session secret — generate a strong random string (minimum 32 chars)
# Example: openssl rand -base64 48
SESSION_SECRET=

# ============================================================
# OPTIONAL (but needed for full functionality)
# ============================================================

# OpenAI API key — used for transcript generation and AI-powered scripts
OPENAI_API_KEY=

# Resend API key — used for transactional emails (password resets, notifications)
# Sign up at https://resend.com
RESEND_API_KEY=

# ============================================================
# SERVER
# ============================================================

# Port the server listens on (default: 5000)
PORT=5000

# Node environment: development | production
NODE_ENV=development

# ============================================================
# FUTURE (Phase 1+)
# ============================================================

# Stripe API keys — payment integration (Phase 1)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# AWS S3 — video storage (Phase 4)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ============================================================
# REMOVED (Replit-specific — do not use)
# ============================================================
# PRIVATE_OBJECT_DIR        — replaced by AWS S3
# PUBLIC_OBJECT_SEARCH_PATHS — replaced by AWS S3
# REPL_ID                   — Replit runtime identifier, not needed
